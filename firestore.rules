rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: persistent user profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection: customer orders with Cash on Delivery
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Chat history for Gemini AI Assistant
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if true;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if true;
    }

    // Test connection check
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
